{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zexor VPN",
  "version": "0.3.3",
  "identifier": "site.zexorvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zexor VPN",
        "width": 460,
        "height": 800,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "minWidth": 400,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://cabinet.zexorvpn.site https://sub.zexorvpn.site; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "externalBin": [
      "binaries/xray"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "shortDescription": "Zexor VPN",
    "longDescription": "VPN-клиент Zexor с блокировщиком рекламы"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Zexor-vp/ZexorVPNApp/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMEFCQTUxMkIwNjU0RjMKUldUelZBWXJVYm9LUHhrRkYrbzE0UXQrKzJPdnJHYUdNVDFWK2lnc2VFYmViem92c2pIa09uQkYK"
    }
  }
}
